# ─── Supabase ────────────────────────────────────────────────────────────────
# Local values match `docker compose up` and `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key

# `mock` renders the workspace from src/lib/mock (design preview, zero setup).
# `supabase` reads and writes the real database.
VITE_DATA_SOURCE=mock

# ─── Workspace ───────────────────────────────────────────────────────────────
VITE_APP_NAME=Qimma Group
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_LOCALE=en
VITE_DEFAULT_TIMEZONE=Asia/Riyadh

# ─── Database (docker compose) ───────────────────────────────────────────────
POSTGRES_DB=arcada
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54322
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/arcada

# ─── Edge functions ──────────────────────────────────────────────────────────
FATOOORA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
FATOOORA_CLIENT_ID=
FATOOORA_CLIENT_SECRET=
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
RESEND_API_KEY=
RESEND_FROM="Qimma People <people@qimma.sa>"
GOSI_API_URL=
GOSI_CLIENT_ID=
GOSI_CLIENT_SECRET=
WPS_BANK_ID=
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
